<html>
  <head>
    <link rel="stylesheet" href="/stylesheets/project.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@200..700&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
      crossorigin="anonymous"
    />
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
      crossorigin="anonymous"
    ></script>
    <script src="https://code.jquery.com/jquery-3.7.1.js" ></script>
    <script src="/javascripts/gift_data.js"></script>
  </head>
  <form action="/product/product_edit_delete" method="post">
  <div class="maincontainer">
    <div class="box">
      <div class="container">
        <div class="row">
          <div class="col-md-12">
            <div style="display: flex; align-items: center">
              <div
                style="
                  display: flex;
                  align-items: center;
                  width: 135px;
                  justify-content: space-between;
                  padding: 5px;
                  border-radius: 5px;
                "
              >
                <span
                  ><img
                    src="/images/gift-box.png"
                    style="width: 33px; height: 33px;"
                /></span>
                <span class="textStyle">Gifteria</span>
              </div>
              <span style="margin-left: auto"
                ><a href='/product/display_all'> <img
                  src="/images/medical-report.png"
                  style="width: 33px; height: 33px;cursor: pointer;text-decoration: none;"
              /></a></span>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="col-md-12">
            <hr />
          </div>
        </div>
        <input type="hidden" name="productid" value="<%=data.productid %>"> 
        <div class="row">
          <div class="col-md-6" style="margin-top: 10px;">
            <select class="form-select" id="categoryid" name="categoryid">
              <option selected value="<%=data.categoryid %>"><%=data.categoryname %></option>
              
            </select>
          </div>
          <div class="col-md-6" style="margin-top: 10px;">
            <select required class="form-select" id="subcategoryid" name="subcategoryid">
             <option selected value="<%=data.subcategoryid %>"><%=data.subcategoryname %></option>
               </select>
          </div>
        </div>

        <div class="row" style="margin-top: 6px;">
          <div class="col-md-12">
            <input required class="form-control" name="productname" value="<%=data.productname %>" type="text" placeholder="Product Name"/>
          </div>
        </div>

       <div class="row" style="margin-top: 6px;">
          <div class="col-md-6">
            <input required value="<%=data.productrate %>" class="form-control" name="productrate" type="text" placeholder="Product Rate"/>
          </div>
          <div class="col-md-6">
            <input required  value="<%=data.productoffer %>" class="form-control" name="productoffer" type="text" placeholder="Product Offer"/>
          </div>
        </div>

      <div class="row" style="margin-top: 6px;">
          <div class="col-md-6">
            <input required class="form-control" value="<%=data.weight %>" name="weight" type="text" placeholder="Product Weight"/>
          </div>
          <div class="col-md-6">
            <input required class="form-control" value="<%=data.stock %>" name="stock" type="text" placeholder="Product Stock"/>
          </div>
        </div>
 
           <div class="row" style="margin-top: 6px;">
          <div class="col-md-6 center" style="margin-top: 10px;" >
            <button name="btn" value="EDIT" type="submit" class="btn btn-primary" style="width:70%;">Edit Record</button>
          </div>
          <div class="col-md-6 center" style="margin-top: 10px;">
            <button name="btn" value="DELETE" type="submit" class="btn btn-primary" style="width:70%;">Delete Record</button>
          </div>
        </div>
   <div class="row" style="margin-top: 6px;">
          <div class="col-md-12 center"  >
           
          </div>
       </div>   



      </div>
    </div>
  </div>
  </form>
</html>
