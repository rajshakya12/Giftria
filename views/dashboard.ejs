<html>
  <head>
    <link rel="stylesheet" href="/stylesheets/project.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,1..1000&family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Oswald:wght@200..700&display=swap"
      rel="stylesheet"
    />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<body>

  <div class="dashboardcontainer">
    <div class="appebar">
      <div style="width: 200px; display: flex; align-items: center">
      <img src="/images/gift.png" style="width:40;" />
      <div class="logoStyle">
       
       Gifteria
       </div>
     </div>
    <div style ="margin-left:auto; width:100;display:flex; justify-content:center;flex-direction:column;align-items:center;">

     <img src="/images/<%=data.picture %>" style="width:40; height:40; border: radius 20px; ;" />
    <span style="font-size:medium;color:#fff;"><%= data.adminname %></span>
    </div>

    </div>
    <div class="row">
        <div class="col-md-2">
          <div class="dashboardbox">
            <div class="itemdashboard">
              <img src="/images/layout.png" width="30" height="30"/>
             <span style="margin-left: 6px;">Dashboard </span>
            </div>
          <div style ="width:100%;padding:1px; background:green;height:1px;"></div>
          <a href="/product/product_interface" target="mw" style= color:black;text-decoration:none;cursor:pointer;"><!-- target="mw" ka use link ko name="mw" wale iframe/window me open karne ke liye hota hai. -->
          <div class="itemdashboard">
              <img src="/images/add.png" width="30" height="30"/>
             <span class="span_style">new product</span>
            </div>
          </a>
          <a href="/product/display_all" target="mw" style= color:black;text-decoration:none;cursor:pointer;"><!--hyper link mein api likhe hai-->
          <div class="itemdashboard">
              <img src="/images/display.png" width="30" height="30"/>
             <span class="span_style">product list</span>
            </div>
            </a>
            <a href="/product/search_interface" target="mw" style= color:black;text-decoration:none;cursor:pointer;">
           <div class="itemdashboard">
              <img src="/images/byid.png" width="30" height="30"/>
             <span class="span_style"> search product </span>
            </div>
            </a>
            <a href="/admin/logout" target="_blank" style= color:black;text-decoration:none;cursor:pointer;">
            <div class="itemdashboard">
              <img src="/images/exit.png" width="30" height="30"/>
             <span class="span_style"> log out </span>
            </div>
          </a>
          </div> 
        </div>
        
        <div class="col-md-8">
          
          <iframe  frameborder="0" name="mw" style="width:1200;height:900" ></iframe>
            
        </div>

</body>

</html>